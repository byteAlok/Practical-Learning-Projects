<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    <h2>Students Lists</h2>
    <table border="1" cellpadding="10" cellspacing="0">
        <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Email</th>
        </tr>   

        <% for (let i of dataJson) { %>
            
            <tr>
                <td><%= i["name"] %></td>
                <td><%= i["age"] %></td>
                <td><%= i["email"] %></td>
                
            </tr>

        <% } %>
        
    </table>

</body>
</html>