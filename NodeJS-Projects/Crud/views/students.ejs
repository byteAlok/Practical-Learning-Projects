<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students List</title>
</head>
<body>

    <div>
    <a href="/">Home Page</a>
    <a href="/form">Registration Form</a>
</div>
<br>
    <table border="1" cellspacing="0" cellpadding="15">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Email</th>
        </tr>
        <% for (let i of data) {%>
            <tr>
                <td><%= i.id %></td>
                <td><%= i.name %></td>
                <td><%= i.age %></td>
                <td><%= i.email %></td>
            </tr>
        <% } %>
    </table>

</body>
</html>