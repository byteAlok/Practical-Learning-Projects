<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Update Page</h1>

    <form action="/update/<%= student._id %>" method="POST">
        <input type="text" name="sname" placeholder="Enter your name" value="<%= student.name %>">
        <input type="number" name="age" placeholder="Enter your age" value="<%= student.age %>">
        <button type="submit">Update</button>
    </form>
</body>
</html>