@inject IHttpContextAccessor HttpContextAccessor

@{
    var uImage = HttpContextAccessor.HttpContext.Session.GetString("UserImage");
    var cImage = HttpContextAccessor.HttpContext.Session.GetString("ClientImage");

    var Uid = HttpContextAccessor.HttpContext.Session.GetInt32("UserId");
    var Cid = HttpContextAccessor.HttpContext.Session.GetInt32("ClientId");

    var FullName = HttpContextAccessor.HttpContext.Session.GetString("UserFullName");

    var image = string.Empty;

    string act = "Index";
    string con = "Home";

    string imgact = "Index";
    string imgcon = "Home";

    if (Uid != null)
    {
        image = uImage;
        act = "Index";
        con = "Freelancer";

        imgact = "Profile";
        imgcon = "FProfile";
    }

    if (Cid != null)
    {
        image = cImage;
        act = "Index";
        con = "Client";

        imgact = "Profile";
        imgcon = "Client";
    }
}





<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - EmpowerHer</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/styles.css">
    <style>
        body {
        font-family: 'Poppins', sans-serif;
        }

        .nav-link {
        transition: color 0.3s ease, background-color 0.3s ease;
        border-radius: 0.5rem;
        }

        .nav-link:hover, .nav-link:focus {
        color: var(--bs-primary) !important;
        background-color: rgba(var(--bs-primary-rgb), 0.05);
        }

        .footer-link {
        transition: color 0.3s ease;
        }

        .footer-link:hover {
        color: #fff !important;
        text-decoration: none;
        }

        .social-links a {
        transition: all 0.3s ease;
        }

        .social-links a:hover {
        background-color: #fff;
        color: var(--bs-dark) !important;
        transform: translateY(-3px);
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-primary fs-3 d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="fas fa-leaf text-success me-2"></i>Empower<span class="text-dark">Her</span>
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                
                
               
                    <ul class="navbar-nav mx-auto fw-medium gap-2">
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link px-3" href="#features">Features</a></li>
                        <li class="nav-item"><a class="nav-link px-3" href="#skills">Skills & Services</a></li>
                    </ul>

                @if (User.Identity.IsAuthenticated && (Uid != null || Cid != null))
                {
                    <div class="d-flex align-items-center py-2">

                        <a class="btn btn-outline-primary rounded-pill px-4 me-3"
                           asp-action="@act"
                           asp-controller="@con">

                            Dashboard

                        </a>

                        <a asp-action="@imgact"
                           asp-controller="@imgcon"
                           class="text-decoration-none">

                            @if (!string.IsNullOrEmpty(image))
                            {
                                <img src="@image"
                                     alt="Profile"
                                     class="shadow-sm"
                                     style="width:45px;
                            height:45px;
                            border-radius:50%;
                            object-fit:cover;
                            border:2px solid #0d6efd;" />
                            }
                            else
                            {
                                <img src="https://ui-avatars.com/api/?name=@FullName&background=0D6EFD&color=fff"
                                     alt="Profile"
                                     class="shadow-sm"
                                     style="width:45px;
                            height:45px;
                            border-radius:50%;
                            object-fit:cover;
                            border:2px solid #0d6efd;" />
                            }

                        </a>

                    </div>
                }
                

                    else
                    {
                        <div class="d-flex mt-3 mt-lg-0 gap-2">
                            <a asp-controller="Authentication" asp-action="Login" class="btn btn-outline-primary px-4 rounded-pill">Login</a>
                            <a asp-controller="Authentication" asp-action="Register" class="btn btn-primary px-4 rounded-pill shadow-sm">Join Now</a>
                        </div>
                    }
                
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer id="contact" class="bg-dark text-white pt-5 pb-4 mt-auto">
        <div class="container pt-3">
            <div class="row gy-4 mb-5">
                <div class="col-lg-5 pe-lg-5">
                    <a class="navbar-brand fw-bold text-white fs-3 mb-3 d-block" href="#">
                        <i class="fas fa-leaf text-success me-2"></i>EmpowerHer
                    </a>
                    <p class="text-white-50 lh-lg mb-4">Creating an accessible digital marketplace bridging skilled women and clients, promoting economic independence without restrictions.</p>
                    <div class="d-flex gap-3 social-links">
                        <a href="#" class="btn btn-outline-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="btn btn-outline-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="btn btn-outline-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="btn btn-outline-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <h5 class="fw-bold mb-4">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li class="mb-3"><a href="#" class="text-white-50 text-decoration-none footer-link">Home</a></li>
                        <li class="mb-3"><a href="#features" class="text-white-50 text-decoration-none footer-link">Features</a></li>
                        <li class="mb-3"><a href="#skills" class="text-white-50 text-decoration-none footer-link">Services</a></li>
                        <li class="mb-3"><a href="#" class="text-white-50 text-decoration-none footer-link">About Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <h5 class="fw-bold mb-4">Legal</h5>
                    <ul class="list-unstyled">
                        <li class="mb-3"><a href="#" class="text-white-50 text-decoration-none footer-link">Terms of Service</a></li>
                        <li class="mb-3"><a href="#" class="text-white-50 text-decoration-none footer-link">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <h5 class="fw-bold mb-4">Contact Us</h5>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-3 d-flex align-items-start"><i class="fas fa-envelope mt-1 me-3 text-primary"></i> ay5332144@gmail.com</li>
                        <li class="mb-3 d-flex align-items-start"><i class="fas fa-phone mt-1 me-3 text-primary"></i> +91 9559451682 , 7800827936</li>
                        <li class="mb-3 d-flex align-items-start"><i class="fas fa-map-marker-alt mt-1 me-3 text-primary"></i> Global Accessible Platform</li>
                    </ul>
                </div>
            </div>

            <div class="border-top border-secondary pt-4 text-center text-white-50 small">
                <p class="mb-0">&copy; 2026 EmpowerHer Skills Platform. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/script.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</html>
