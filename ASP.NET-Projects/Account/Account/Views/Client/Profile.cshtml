@model Account.Models.UserClass
@{
    ViewData["Title"] = "My Profile";
    Layout = "_ClientSidebarLayout";
    var profileImage = string.IsNullOrEmpty(Model.ProfilePhotoPath) ? "/images/default-avatar.png" : Model.ProfilePhotoPath;
}
<style>
    .logout-btn:hover {
        background-color: #dc3545;
        color: white !important;
    }

        .logout-btn:hover i {
            color: white !important;
        }
</style>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center text-md-start">
                    <div class="d-md-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex align-items-center flex-column flex-md-row gap-3">
                            <img src="@profileImage" alt="Profile Image" class="rounded-circle object-fit-cover shadow-sm border border-light" style="width: 100px; height: 100px;" />
                            <div>
                                <h2 class="h3 mb-0 fw-bold">@Model.FullName </h2>
                                <span class="badge @(Model.Role == "Client" ? "bg-primary" : "bg-success") mt-1">@Model.Role</span>
                            </div>
                        </div>
                        <div class="mt-3 mt-md-0">
                            <a asp-action="Edit" class="btn btn-outline-primary rounded-pill px-4"><i class="fas fa-edit me-1"></i> Edit Profile</a>
                            <a asp-controller="Authentication"
                               asp-action="Logout"
                               class="btn btn-outline-danger rounded-pill px-4 py-2 logout-btn">
                                <i class="fas fa-sign-out-alt me-2"></i> Logout
                            </a>
                        </div>
                    </div>

                    <hr class="text-secondary opacity-25">

                    <div class="row mb-3 mt-4">
                        <div class="col-sm-4 text-muted fw-semibold"><i class="fas fa-envelope me-2"></i>Email</div>
                        <div class="col-sm-8">@Model.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-semibold"><i class="fas fa-map-marker-alt me-2 px-1"></i>Location</div>
                        <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Location) ? "Not specified" : Model.Location)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-semibold"><i class="fas fa-info-circle me-2"></i>Bio</div>
                        <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Bio) ? "Not specified" : Model.Bio)</div>
                    </div>

                    @if (Model.Role == "Freelancer")
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-semibold"><i class="fas fa-tools me-2"></i>Skills</div>
                            <div class="col-sm-8">
                                @if (string.IsNullOrEmpty(Model.Skills))
                                {
                                    <span>Not specified</span>
                                }
                                else
                                {
                                    @foreach (var skill in Model.Skills.Split(','))
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1">@skill.Trim()</span>
                                    }
                                }
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-semibold"><i class="fas fa-star text-warning me-2"></i>Rating</div>
                            <div class="col-sm-8">
                                @if (Model.Rating.HasValue)
                                {
                                    <span class="fw-bold">@Model.Rating.Value.ToString("0.0")</span> <span class="text-muted">/ 5.0</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No ratings yet</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
