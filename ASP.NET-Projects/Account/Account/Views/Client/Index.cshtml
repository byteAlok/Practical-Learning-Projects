
@model Account.Models.UserClass
@inject IHttpContextAccessor HttpContextAccessor
@{
    var uImage = HttpContextAccessor.HttpContext.Session.GetString("UserImage");
    var cImage = HttpContextAccessor.HttpContext.Session.GetString("ClientImage");
    var FullName = HttpContextAccessor.HttpContext.Session.GetString("ClientFullName");

    var Uid = HttpContextAccessor.HttpContext.Session.GetInt32("UserId");
    var Cid = HttpContextAccessor.HttpContext.Session.GetInt32("ClientId");

    var image = string.Empty; string act = "Index"; string con = "Home";
    string imgact = "Index"; string imgcon = "Home";

    if (Uid != null) { image = uImage; act = "Index"; con = "Freelancer"; imgact = "Index"; imgcon = "Freelancer"; }
    if (Cid != null) { image = cImage; act = "Index"; con = "Client"; imgact = "Edit"; imgcon = "Client"; }
}

@{
    ViewData["Title"] = "Client Dashboard";
    Layout = "~/Views/Shared/_ClientSidebarLayout.cshtml";
}
<h5 class="text-center text-success">@TempData["Success"]</h5>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Dashboard Overview</h3>

    <p class="text-muted mb-0 d-none d-sm-block">
        Welcome back, @FullName!
    </p>
</div>

<!-- Stats Row -->
<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 dashboard-card p-3 h-100 relative">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted fw-bold text-uppercase mb-2 small tracking-wide">
                            Jobs Posted
                        </h6>

                        <h2 class="fw-bold mb-0">
                            @ViewBag.TotalJobsPosted
                        </h2>
                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 50px; height: 50px;">

                        <i class="fas fa-clipboard-list fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 dashboard-card info p-3 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted fw-bold text-uppercase mb-2 small tracking-wide">
                            Active Jobs
                        </h6>

                        <h2 class="fw-bold mb-0">
                            @ViewBag.ActiveJobs
                        </h2>
                    </div>

                    <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 50px; height: 50px;">

                        <i class="fas fa-spinner fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 dashboard-card success p-3 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted fw-bold text-uppercase mb-2 small tracking-wide">
                            Total Hired
                        </h6>

                        <h2 class="fw-bold mb-0">
                            @ViewBag.ActiveJobs
                        </h2>
                    </div>

                    <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 50px; height: 50px;">

                        <i class="fas fa-handshake fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- Recent Activity & Active Jobs -->
<div class="row g-4">

    <div class="col-xl-8">

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">My Recent Job Postings</h5>

                <a href="#"
                   class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    View All
                </a>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light text-muted small">
                            <tr>
                                <th class="ps-4">Job Title</th>
                                <th>Category</th>
                                <th>Bids</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (ViewBag.RecentJobs != null)
                            {
                                @foreach (var job in ViewBag.RecentJobs)
                                {
                                    <tr>

                                        <td class="ps-4 py-3">

                                            <h6 class="fw-bold mb-1">
                                                <a href="#"
                                                   class="text-dark text-decoration-none">

                                                    @job.JobTitle

                                                </a>
                                            </h6>

                                            <small class="text-muted">

                                                Posted on
                                                @job.CreatedAt.ToString("dd MMM yyyy")

                                            </small>

                                        </td>

                                        <td>

                                            <span class="badge bg-light text-dark border">

                                                @job.JobCategory

                                            </span>

                                        </td>

                                        <td>

                                            <span class="badge bg-primary rounded-pill">

                                                0 Bids

                                            </span>

                                        </td>

                                        <td>

                                            @if (job.Status == "Open")
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    Active
                                                </span>
                                            }
                                            else if (job.Status == "Completed")
                                            {
                                                <span class="badge bg-primary-subtle text-primary">
                                                    Completed
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">
                                                    @job.Status
                                                </span>
                                            }

                                        </td>

                                        <td class="text-end pe-4">

                                            <a asp-controller="Client"
                                               asp-action="JobDetails"
                                               asp-route-id="@job.Id"
                                               class="btn btn-sm btn-light text-primary border">

                                                <i class="fas fa-eye"></i> View

                                            </a>

                                        </td>

                                    </tr>
                                }
                                @if (((List<JobPostClass>)ViewBag.RecentJobs).Count == 0)
                                {
                                    <tr>

                                        <td colspan="5" class="text-center py-4 text-muted">

                                            No jobs posted yet.

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">

        <div class="card border-0 shadow-sm rounded-4 h-100">

            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    Recent Bids Received
                </h5>
            </div>

            <div class="card-body p-3">

                <!-- Bid Item -->
                <div class="d-flex align-items-center mb-3 p-3 bg-light rounded-3">

                    <img src="https://ui-avatars.com/api/?name=Amina+K&background=random"
                         alt="User"
                         class="rounded-circle me-3"
                         width="45"
                         height="45">

                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-0">Amina K.</h6>

                        <p class="text-muted small mb-0 w-100 text-truncate"
                           style="max-width: 150px;">

                            Bid on "Custom stitched dress"
                        </p>
                    </div>

                    <a href="#"
                       class="btn btn-sm btn-outline-primary rounded-circle"
                       style="width:32px; height:32px; padding:0; display:flex; align-items:center; justify-content:center;">

                        <i class="fas fa-chevron-right"></i>
                    </a>
                </div>

                <!-- Bid Item -->
                <div class="d-flex align-items-center mb-3 p-3 bg-light rounded-3">

                    <img src="https://ui-avatars.com/api/?name=Fatima+Z&background=random"
                         alt="User"
                         class="rounded-circle me-3"
                         width="45"
                         height="45">

                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-0">Fatima Z.</h6>

                        <p class="text-muted small mb-0 w-100 text-truncate"
                           style="max-width: 150px;">

                            Bid on "Custom stitched dress"
                        </p>
                    </div>

                    <a href="#"
                       class="btn btn-sm btn-outline-primary rounded-circle"
                       style="width:32px; height:32px; padding:0; display:flex; align-items:center; justify-content:center;">

                        <i class="fas fa-chevron-right"></i>
                    </a>
                </div>

                <div class="text-center mt-3">
                    <a href="#"
                       class="text-primary text-decoration-none small fw-bold">
                        View All Bids
                    </a>
                </div>

            </div>
        </div>

    </div>

</div>