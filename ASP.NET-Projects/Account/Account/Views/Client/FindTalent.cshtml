@model IEnumerable<Account.Models.UserClass>
@{
    ViewData["Title"] = "Find Talent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .hover-lift:hover {
        transform: translateY(-5px);
    }

    .CTA-section {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
    }
</style>

<!-- ================= SEARCH HEADER SECTION ================= -->

<div class="bg-primary pt-5 pb-5 CTA-section position-relative">

    <div class="container position-relative z-1 text-center">

        <h2 class="text-white fw-bold mb-3">
            Find Expert Women Freelancers
        </h2>

        <div class="row justify-content-center">

            <div class="col-md-8">

                <form asp-controller="Client"
                      asp-action="FindTalent"
                      method="get">

                    <div class="input-group input-group-lg shadow-lg rounded-pill overflow-hidden">

                        <span class="input-group-text bg-white border-0 ps-4 text-muted">
                            <i class="fas fa-search"></i>
                        </span>

                        <input type="text"
                               class="form-control border-0 px-3"
                               name="search"
                               value="@ViewBag.Search"
                               placeholder="Search by skills, name, bio or location...">
                        <button type="submit"
                                class="btn btn-dark px-4 fw-bold">

                            Find Talent
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<!-- ================= FREELANCER SECTION ================= -->

<div class="container py-5">

    <!-- Heading -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h5 class="fw-bold mb-0">

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <text>
                    Search Results for "@ViewBag.Search"
                </text>
            }
            else
            {
                <text>
                    Recommended Freelancers
                </text>
            }

        </h5>

        <div class="d-flex align-items-center gap-2">

            <span class="text-muted small text-nowrap">
                Sort by:
            </span>

            <select class="form-select form-select-sm border-0 bg-white shadow-sm rounded-pill fw-medium">
                <option>Highest Ranked</option>
                <option>Most Jobs Completed</option>
                <option>Newest</option>
            </select>

        </div>

    </div>

    <!-- Cards Row -->
    <div class="row g-4">

        <!-- Freelancer Card -->
        <div class="row g-4">

            @if (Model != null && Model.Any())
            {
                @foreach (var freelancer in Model)
                {
                    <div class="col-md-6 col-xl-4">

                        <div class="card border-0 shadow-sm rounded-4 h-100 text-center hover-lift"
                             style="transition: transform 0.2s;">

                            <div class="card-body p-4">

                                <!-- Profile Image -->
                                <div class="mb-3 position-relative d-inline-block">

                                    <img src="@(string.IsNullOrEmpty(freelancer.ProfilePhotoPath)
                                        ? $"https://ui-avatars.com/api/?name={freelancer.FullName}&background=d81b60&color=fff&size=128"
                                        : freelancer.ProfilePhotoPath)"
                                         class="rounded-circle img-thumbnail border-2"
                                         style="width:100px;height:100px;object-fit:cover;">

                                </div>

                                <!-- Name -->
                                <h5 class="fw-bold mb-1">
                                    @freelancer.FullName
                                </h5>

                                <!-- Bio -->
                                <p class="text-muted small mb-2">
                                    @(freelancer.Bio ?? "Professional Freelancer")
                                </p>

                                <!-- Rating -->
                                <div class="text-warning small mb-3">

                                    <i class="fas fa-star"></i>

                                    <span class="text-dark fw-bold ms-1">
                                        @(freelancer.Rating ?? 0)
                                    </span>

                                </div>

                                <!-- Skills -->
                                <div class="d-flex flex-wrap justify-content-center gap-1 mb-4">

                                    @if (!string.IsNullOrEmpty(freelancer.Skills))
                                    {
                                        var skills = freelancer.Skills.Split(',');

                                        foreach (var skill in skills)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @skill
                                            </span>
                                        }
                                    }

                                </div>

                                <!-- Location -->
                                <div class="text-muted small border-top pt-3 mb-4">

                                    <i class="fas fa-map-marker-alt me-1"></i>
                                    @(freelancer.Location ?? "Location not added")

                                </div>

                                <!-- Button -->
                                <a asp-controller="Client"
                                   asp-action="FreelancerDetails"
                                   asp-route-id="@freelancer.Id"
                                   class="btn btn-outline-primary rounded-pill w-100">

                                    View Profile

                                </a>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="alert alert-warning rounded-4 shadow-sm">

                        No freelancers found.

                    </div>

                </div>
            }

        </div>

    </div>

</div>