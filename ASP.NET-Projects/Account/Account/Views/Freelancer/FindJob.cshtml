@model List<Account.Models.JobPostClass>

@{
    ViewData["Title"] = "Find Jobs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .hover-lift {
        transition: transform 0.2s;
    }

        .hover-lift:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<!-- Header Search Banner -->
<div class="bg-primary pt-5 pb-5 CTA-section position-relative">

    <div class="container position-relative z-1 text-center">

        <h2 class="text-white fw-bold mb-3">
            Find Work that Matches Your Skills
        </h2>

        <div class="row justify-content-center">

            <div class="col-md-8">

                <form method="get"
                      asp-controller="Freelancer"
                      asp-action="FindJob">

                    <div class="input-group input-group-lg shadow-lg rounded-pill overflow-hidden">

                        <span class="input-group-text bg-white border-0 ps-4 text-muted">
                            <i class="fas fa-search"></i>
                        </span>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control border-0 px-3"
                               placeholder="Search by skills, category, or keywords...">

                        <button type="submit"
                                class="btn btn-dark px-4 fw-bold">

                            Search Jobs
                        </button>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <div class="row g-4">

        <!-- Sidebar -->
        <div class="col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 sticky-top"
                 style="top: 100px;">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Filters
                    </h5>

                    <p class="text-muted small mb-0">
                        Search jobs by category, skills, and keywords.
                    </p>

                </div>
            </div>
        </div>

        <!-- Job Listings -->
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h5 class="fw-bold mb-0">
                    @Model.Count Jobs Found
                </h5>
             

            </div>

            @if (Model.Any())
            {
                @foreach (var job in Model)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4 hover-lift">

                        <div class="card-body p-4">

                            <div class="row">

                                <!-- Left -->
                                <div class="col-lg-9">

                                    <h4 class="fw-bold mb-2">

                                        <a href="#"
                                           class="text-dark text-decoration-none">

                                            @job.JobTitle
                                        </a>

                                    </h4>

                                    <div class="mb-3 d-flex gap-2 flex-wrap">

                                        <span class="badge bg-primary-subtle text-primary border rounded-pill">
                                            @job.JobCategory
                                        </span>

                                        <span class="badge bg-light text-dark border rounded-pill">
                                            @(string.IsNullOrEmpty(job.LocationType)
                                                ? "Remote"
                                                : job.LocationType)
                                        </span>

                                        <span class="badge bg-success-subtle text-success border rounded-pill">

                                            <i class="fas fa-check-circle me-1"></i>
                                            Open
                                        </span>

                                    </div>

                                    <p class="text-muted mb-3 line-clamp-2">
                                        @job.JobDescription
                                    </p>

                                    <div class="d-flex flex-wrap gap-2 mb-3">

                                        <span class="badge bg-light text-dark border p-2">
                                            @job.JobCategory
                                        </span>

                                    </div>

                                </div>

                                <!-- Right -->
                                <div class="col-lg-3 text-lg-end ps-lg-4 mt-3 mt-lg-0 d-flex flex-column justify-content-between">

                                    <div>

                                        <h4 class="fw-bold text-primary mb-1">
                                            ₹@job.Budget
                                        </h4>

                                        <p class="text-muted small mb-0">
                                            Budget
                                        </p>

                                    </div>

                                    <div class="mt-3">

                                        <p class="text-muted small mb-2">

                                            <i class="far fa-clock me-1"></i>

                                            Posted
                                            @job.CreatedAt.ToString("dd MMM yyyy")
                                        </p>

                                        <p class="text-muted small mb-3">

                                            <i class="fas fa-user me-1"></i>

                                            @(job.Client != null
                                                ? job.Client.FullName
                                                : "Client")
                                        </p>

                                        <a asp-controller="Freelancer"
                                           asp-action="JobDetails"
                                           asp-route-id="@job.Id"
                                           class="btn btn-outline-primary rounded-pill w-100">

                                            Job Details
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body text-center p-5">

                        <i class="fas fa-briefcase fa-3x text-muted mb-3"></i>

                        <h4 class="fw-bold">
                            No Jobs Found
                        </h4>

                        <p class="text-muted mb-0">
                            Try searching with different keywords.
                        </p>

                    </div>
                </div>
            }

        </div>
    </div>
</div>