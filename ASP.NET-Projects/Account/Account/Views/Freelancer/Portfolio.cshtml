@model Account.Models.ViewModels.FreelancerDashboardViewModel

@{
    ViewData["Title"] = "My Portfolio";
    Layout = "~/Views/Shared/_UserSidebarLayout.cshtml";
}

<style>
    .portfolio-banner {
        background: linear-gradient(135deg, #6fb1fc, #a1c4fd);
        border-radius: 24px;
        padding: 50px 40px;
        color: white;
        position: relative;
        overflow: hidden;
    }

        .portfolio-banner::before {
            content: '';
            position: absolute;
            right: -50px;
            top: -50px;
            width: 220px;
            height: 220px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
        }

    .portfolio-card {
        transition: all 0.3s ease;
        border: none;
    }

        .portfolio-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.12);
        }

    .portfolio-img {
        height: 240px;
        object-fit: cover;
    }

    .empty-state {
        padding: 80px 20px;
    }

    .add-btn {
        border-radius: 50px;
        padding: 12px 24px;
        font-weight: 600;
    }
</style>

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="portfolio-banner shadow-sm mb-4">

        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center">

            <div>
                <h2 class="fw-bold mb-2">
                    My Portfolio
                </h2>

                <p class="mb-0 text-white-50">
                    Showcase your best projects and impress clients.
                </p>
            </div>

            <div class="mt-4 mt-lg-0">

                <a asp-controller="Freelancer"
                   asp-action="PortfolioPost"
                   class="btn btn-light text-primary add-btn shadow-sm">

                    <i class="fas fa-plus-circle me-2"></i>
                    Add New Project

                </a>

            </div>

        </div>

    </div>

    <!-- Portfolio Grid -->
    <div class="row g-4">

        @if (Model.PortfolioPosts != null && Model.PortfolioPosts.Any())
        {
            @foreach (var post in Model.PortfolioPosts)
            {
                <div class="col-md-6 col-xl-4">

                    <div class="card portfolio-card rounded-4 overflow-hidden h-100 shadow-sm">

                        <!-- Image -->
                        @if (!string.IsNullOrEmpty(post.ImagePath))
                        {
                            <img src="@post.ImagePath"
                                 class="card-img-top portfolio-img">
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/600x400?text=Portfolio+Project"
                                 class="card-img-top portfolio-img">
                        }

                        <!-- Content -->
                        <div class="card-body p-4 d-flex flex-column">

                            <div class="mb-3">

                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                    Portfolio Project
                                </span>

                            </div>

                            <h5 class="fw-bold mb-3">
                                @post.Title
                            </h5>

                            <p class="text-muted small flex-grow-1">

                                @(post.Description.Length > 140
                                    ? post.Description.Substring(0, 140) + "..."
                                    : post.Description)

                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3">

                                <small class="text-muted">

                                    <i class="far fa-calendar-alt me-1"></i>

                                    @post.CreatedAt.ToString("dd MMM yyyy")

                                </small>

                                <div class="dropdown">

                                    <button class="btn btn-light btn-sm rounded-circle"
                                            data-bs-toggle="dropdown">

                                        <i class="fas fa-ellipsis-v"></i>

                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Portfolio"
                                               asp-action="Details"
                                               asp-route-id="@post.Id">

                                                <i class="fas fa-eye me-2 text-primary"></i>
                                                View

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Portfolio"
                                               asp-action="Edit"
                                               asp-route-id="@post.Id">

                                                <i class="fas fa-edit me-2 text-success"></i>
                                                Edit

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item text-danger"
                                               asp-controller="Portfolio"
                                               asp-action="Delete"
                                               asp-route-id="@post.Id">

                                                <i class="fas fa-trash me-2"></i>
                                                Delete

                                            </a>
                                        </li>

                                    </ul>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body text-center empty-state">

                        <i class="fas fa-images fa-4x text-primary mb-4"></i>

                        <h3 class="fw-bold mb-3">
                            No Portfolio Projects Yet
                        </h3>

                        <p class="text-muted mb-4">
                            Add your best work to attract more clients and build trust.
                        </p>

                        <a asp-controller="Portfolio"
                           asp-action="Create"
                           class="btn btn-primary add-btn">

                            <i class="fas fa-plus-circle me-2"></i>
                            Add First Project

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>