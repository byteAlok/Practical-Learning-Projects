@{
    ViewData["Title"] = "Login";
}

<div class="container min-vh-100 d-flex justify-content-center py-5 mt-5" style="align-items:flex-start; padding-top:80px;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="max-width: 900px; width: 100%;">
        <div class="row g-0">
            <div class="col-md-6 bg-primary d-none d-md-flex align-items-center justify-content-center p-5 text-white flex-column position-relative CTA-section">
                <div class="position-relative z-1 text-center">
                    <i class="fas fa-leaf fa-3x mb-3 text-success"></i>
                    <h2 class="fw-bold fs-1 mb-3">Welcome Back!</h2>
                    <p class="lead text-white-50">Log in to EmpowerHer to continue showcasing your skills or finding the right talent.</p>
                </div>
            </div>
            <div class="col-md-6 p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark">Sign In</h3>
                    <p class="text-muted">Access your dashboard</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-3"><i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]</div>
                }

                <form asp-controller="Authentication" asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="floatingInput" name="NameorEmail" placeholder="name@example.com" required>
                        <label for="floatingInput">Name or Email</label>
                    </div>
                    <div class="form-floating mb-2">
                        <input type="password" class="form-control" id="floatingPassword" name="pass" placeholder="Password" required>
                        <label for="floatingPassword">Password</label>
                    </div>
                    <div class="text-end mb-4">
                        <a asp-action="ForgetPassword" asp-controller="ResetPassword" class="text-primary text-decoration-none small">Forgot Password?</a>
                    </div>

                    <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold mb-3 shadow-sm" type="submit">Sign In</button>

                    <div class="text-center mt-3">
                        <p class="text-muted small">Don't have an account? <a asp-controller="Authentication" asp-action="Register" class="text-primary fw-bold text-decoration-none">Sign up</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
