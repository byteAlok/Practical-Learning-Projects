
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<form method="post">

    <label>Name</label>
    <input type="text" placeholder="Your Name" name="name"/>

    <label>Email</label>
    <input type="text" placeholder="Email" name="email"/>

    <label>Address</label>
    <input type="text" placeholder="Address" name="address"/>

    <input type="submit" value="Submit"/>

</form>
<h2>@ViewBag.Msg</h2>