@model List<MyCrud.Models.Student>
@{
    ViewBag.Title = "Show";
}


<div class="row m-0 p-0">
    <div class="col-sm"></div>
    <div class="col-sm-8">

        <h2 class="text-success text-center mt-2 bg-light">Database Table</h2>


        <table class="table table-success table-striped table-hover">
            <tr>
                <th>Student Id</th>
                <th>Student Name</th>
                <th>Student Email</th>
                <th>Student Address</th>
            </tr>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.Name</td>
                    <td>@s.Email</td>
                    <td>@s.Address</td>

                </tr>
            }
        </table>

    </div>
    <div class="col-sm">
        <p class="text-center text-primary mt-4">@TempData["msg"]</p>
    </div>
</div>